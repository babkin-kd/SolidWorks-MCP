# Keep text changes consistent across Windows and other platforms.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Documentation images must remain byte-for-byte unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
